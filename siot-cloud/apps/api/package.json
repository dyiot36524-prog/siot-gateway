{
  "name": "@siot/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "시옷 클라우드 API: 공개 API v1, 앱 API, 게이트웨이 릴레이, 웹훅 워커 (Fastify 5)",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint:openapi": "redocly lint openapi/public-v1.yaml openapi/app-v1.yaml",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "admin": "tsx src/admin/cli.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/websocket": "^11.3.4",
    "@siot/protocol": "0.1.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "argon2": "^0.45.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "pino": "^9.14.0",
    "postgres": "^3.4.9",
    "prom-client": "^15.1.3",
    "tsx": "^4.23.15",
    "ulid": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@redocly/cli": "^2.66.0",
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "yaml": "^2.9.1"
  }
}
