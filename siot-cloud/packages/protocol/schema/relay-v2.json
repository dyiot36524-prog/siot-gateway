{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.siot.dev/protocol/relay-v2.json",
  "title": "RelayV2Frame",
  "description": "시옷 클라우드 ↔ 게이트웨이 WebSocket 릴레이 proto 2 (계획 §2 b, B1). 모든 프레임은 {t:\"<type>\", ...} JSON 텍스트 메시지. 방향은 각 정의의 x-direction(server_to_gateway | gateway_to_server | both). 생산자는 스키마를 엄격히 지키고(additionalProperties:false), 수신자는 모르는 필드를 무시한다. 접속: wss://siot-cloud.fly.dev/gateway, 헤더 X-Siot-Gateway-Id + (바인딩 후) Authorization: Bearer <gatewayToken>. 쿼리 토큰 4401, 미등록 키 4403.",
  "anyOf": [
    {
      "$ref": "#/$defs/ServerToGateway"
    },
    {
      "$ref": "#/$defs/GatewayToServer"
    }
  ],
  "$defs": {
    "GatewayId": {
      "title": "GatewayId",
      "type": "string",
      "pattern": "^gw_[0-9a-f-]{36}$",
      "examples": [
        "gw_739f694e-76be-5888-be41-639544c21b5b"
      ]
    },
    "SiteId": {
      "title": "SiteId",
      "type": "string",
      "pattern": "^site_[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "'site_' + ULID",
      "examples": [
        "site_01JZ8Q0V4Y4W6P1M2N3B5C7D9E"
      ]
    },
    "BootId": {
      "title": "BootId",
      "type": "string",
      "format": "uuid",
      "description": "에이전트 프로세스 시작마다 새로 만드는 uuid v4. seq 는 bootId 마다 1부터."
    },
    "EvtSeq": {
      "title": "EvtSeq",
      "type": "integer",
      "minimum": 1
    },
    "KeyVersion": {
      "title": "KeyVersion",
      "type": "integer",
      "minimum": 0,
      "description": "세대 키 버전. 미바인딩·미설정이면 0."
    },
    "CfgVersion": {
      "title": "CfgVersion",
      "type": "integer",
      "minimum": 0,
      "description": "서버가 발급하는 단조 증가 설정 버전. 미설정이면 0."
    },
    "IsoTime": {
      "title": "IsoTime",
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 (new Date().toISOString())"
    },
    "Base64": {
      "title": "Base64",
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]*={0,2}$",
      "contentEncoding": "base64"
    },
    "StringMap": {
      "title": "StringMap",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "SiteKey": {
      "title": "SiteKey",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "key"
      ],
      "properties": {
        "v": {
          "type": "integer",
          "minimum": 1
        },
        "key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$",
          "description": "세대 키 32바이트 base64url(패딩 없음)"
        }
      }
    },
    "Peer": {
      "title": "Peer",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gatewayId",
        "lan",
        "mleid"
      ],
      "properties": {
        "gatewayId": {
          "$ref": "#/$defs/GatewayId"
        },
        "lan": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "LAN 주소(IPv4/IPv6, 포트 3443/tcp 고정)"
        },
        "mleid": {
          "type": [
            "string",
            "null"
          ],
          "description": "Thread ML-EID IPv6 주소. 아직 모르면 null"
        }
      }
    },
    "Rules": {
      "title": "Rules",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "rules"
      ],
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 0
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Rule"
          }
        }
      },
      "description": "세대 자동화 규칙 전체(게이트웨이 몫만). version 은 세대 규칙 버전(저장마다 +1, 0 = 플랫폼이 아직 보낸 적 없음). GW 는 version 이 지금보다 크지 않으면 무시하고, 적용 후 cfg_ack.rulesVersion 으로 보고한다."
    },
    "RuleScalar": {
      "title": "RuleScalar",
      "type": [
        "boolean",
        "number"
      ]
    },
    "Weekday": {
      "title": "Weekday",
      "type": "string",
      "enum": [
        "mon",
        "tue",
        "wed",
        "thu",
        "fri",
        "sat",
        "sun"
      ]
    },
    "RuleDeviceTrigger": {
      "title": "RuleDeviceTrigger",
      "description": "기기 값 변화. type 이 없으면 device 로 본다(옛 rules.json 호환). changedTo(이전 값과 달라져 이 값이 될 때) 또는 equals 중 정확히 하나.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deviceId",
        "capability",
        "field"
      ],
      "properties": {
        "type": {
          "const": "device"
        },
        "deviceId": {
          "type": "string",
          "minLength": 1,
          "description": "게이트웨이 로컬 노드 ID(로컬 기기 ID matter:<node>:<ep> 의 앞부분)",
          "examples": [
            "matter:5"
          ]
        },
        "endpoint": {
          "type": "integer",
          "minimum": 0,
          "description": "없으면 노드의 모든 엔드포인트(battery·power·energy 처럼 다른 엔드포인트에서 합쳐진 값)"
        },
        "capability": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "onoff",
            "contact"
          ]
        },
        "field": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "on",
            "open"
          ]
        },
        "changedTo": {
          "$ref": "#/$defs/RuleScalar"
        },
        "equals": {
          "$ref": "#/$defs/RuleScalar"
        }
      },
      "if": {
        "type": "object",
        "required": [
          "changedTo"
        ],
        "properties": {
          "changedTo": true
        }
      },
      "then": {
        "not": {
          "type": "object",
          "required": [
            "equals"
          ],
          "properties": {
            "equals": true
          }
        }
      },
      "else": {
        "type": "object",
        "required": [
          "equals"
        ],
        "properties": {
          "equals": true
        }
      }
    },
    "RuleScheduleTrigger": {
      "title": "RuleScheduleTrigger",
      "description": "매일(또는 days 요일) tz 기준 at 시각에 분당 1회. 게이트웨이 시계가 동기되지 않았으면 발동하지 않는다.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "at"
      ],
      "properties": {
        "type": {
          "const": "schedule"
        },
        "at": {
          "type": "string",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "examples": [
            "22:00"
          ]
        },
        "days": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/Weekday"
          },
          "description": "없으면 매일"
        },
        "tz": {
          "type": "string",
          "minLength": 1,
          "description": "IANA 시간대. 없으면 Asia/Seoul",
          "examples": [
            "Asia/Seoul"
          ]
        }
      }
    },
    "RuleCondition": {
      "title": "RuleCondition",
      "description": "발동 시점의 기기 값 검사. equals·gt·lt 중 정확히 하나.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deviceId",
        "capability",
        "field"
      ],
      "properties": {
        "deviceId": {
          "type": "string",
          "minLength": 1,
          "description": "게이트웨이 로컬 노드 ID(로컬 기기 ID matter:<node>:<ep> 의 앞부분)",
          "examples": [
            "matter:5"
          ]
        },
        "endpoint": {
          "type": "integer",
          "minimum": 0,
          "description": "없으면 노드의 모든 엔드포인트(battery·power·energy 처럼 다른 엔드포인트에서 합쳐진 값)"
        },
        "capability": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "onoff",
            "contact"
          ]
        },
        "field": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "on",
            "open"
          ]
        },
        "equals": {
          "$ref": "#/$defs/RuleScalar"
        },
        "gt": {
          "type": "number"
        },
        "lt": {
          "type": "number"
        }
      },
      "if": {
        "type": "object",
        "required": [
          "equals"
        ],
        "properties": {
          "equals": true
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "gt"
              ],
              "properties": {
                "gt": true
              }
            },
            {
              "type": "object",
              "required": [
                "lt"
              ],
              "properties": {
                "lt": true
              }
            }
          ]
        }
      },
      "else": {
        "if": {
          "type": "object",
          "required": [
            "gt"
          ],
          "properties": {
            "gt": true
          }
        },
        "then": {
          "not": {
            "type": "object",
            "required": [
              "lt"
            ],
            "properties": {
              "lt": true
            }
          }
        },
        "else": {
          "type": "object",
          "required": [
            "lt"
          ],
          "properties": {
            "lt": true
          }
        }
      }
    },
    "RuleCommandAction": {
      "title": "RuleCommandAction",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "deviceId",
        "capability",
        "action"
      ],
      "properties": {
        "type": {
          "const": "command"
        },
        "deviceId": {
          "type": "string",
          "minLength": 1,
          "description": "게이트웨이 로컬 노드 ID(로컬 기기 ID matter:<node>:<ep> 의 앞부분)",
          "examples": [
            "matter:5"
          ]
        },
        "endpoint": {
          "type": "integer",
          "minimum": 0
        },
        "capability": {
          "const": "onoff"
        },
        "action": {
          "type": "string",
          "enum": [
            "on",
            "off",
            "toggle"
          ]
        }
      }
    },
    "RuleDelayAction": {
      "title": "RuleDelayAction",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "ms"
      ],
      "properties": {
        "type": {
          "const": "delay"
        },
        "ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        }
      }
    },
    "Rule": {
      "title": "Rule",
      "description": "게이트웨이 로컬 자동화 규칙(에이전트가 실행하는 유일한 형식, /app/data/rules.json 과 같다). 클라우드가 공개 AutomationRule 을 컴파일해 cfg.rules 로 보낸다.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "trigger",
        "actions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "aut_01JZ8Q0V4Y4W6P1M2N3B5C7D9E"
          ]
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "enabled": {
          "type": "boolean",
          "description": "없으면 true"
        },
        "trigger": {
          "oneOf": [
            {
              "$ref": "#/$defs/RuleDeviceTrigger"
            },
            {
              "$ref": "#/$defs/RuleScheduleTrigger"
            }
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RuleCondition"
          }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/RuleCommandAction"
              },
              {
                "$ref": "#/$defs/RuleDelayAction"
              }
            ]
          }
        }
      }
    },
    "ThreadCfg": {
      "title": "ThreadCfg",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "description": "M2 부터. M1 cfg 에는 없다.",
      "properties": {
        "mode": {
          "enum": [
            "adopt",
            "form",
            "join",
            "wait"
          ]
        },
        "datasetRef": {
          "type": "string"
        }
      }
    },
    "GatewayStatus": {
      "title": "GatewayStatus",
      "type": "object",
      "additionalProperties": true,
      "required": [
        "gatewayId",
        "agentVersion",
        "engineOnline",
        "deviceCount"
      ],
      "description": "snapshot.gateway. 필수 4개 외 진단 필드는 자유(matterServerVersion, startedAt, lastErrorCode, engine 등).",
      "properties": {
        "gatewayId": {
          "$ref": "#/$defs/GatewayId"
        },
        "agentVersion": {
          "type": "string"
        },
        "matterServerVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "engineOnline": {
          "type": "boolean"
        },
        "deviceCount": {
          "type": "integer",
          "minimum": 0
        },
        "startedAt": {
          "$ref": "#/$defs/IsoTime"
        },
        "lastErrorCode": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "PairingStage": {
      "title": "PairingStage",
      "enum": [
        "queued",
        "thread_dataset",
        "commissioning",
        "interviewing",
        "done",
        "failed"
      ]
    },
    "Challenge": {
      "title": "ChallengeFrame",
      "x-direction": "server_to_gateway",
      "description": "접속 직후 서버가 보낸다. GW 는 hello.sig 로 nonce 에 서명한다.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "t",
        "nonce"
      ],
      "properties": {
        "t": {
          "const": "challenge"
        },
        "nonce": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128
        }
      }
    },
    "Welcome": {
      "title": "WelcomeFrame",
      "x-direction": "server_to_gateway",
      "description": "hello 검증 후. cfgVersion 이 GW 보고값보다 크면 서버가 곧바로 cfg 를 보낸다.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "t",
        "serverTime",
        "heartbeatSec",
        "deadSec",
        "cfgVersion"
      ],
      "properties": {
        "t": {
          "const": "welcome"
        },
        "serverTime": {
          "$ref": "#/$defs/IsoTime"
        },
        "heartbeatSec": {
          "type": "integer",
          "minimum": 1,
          "default": 10
        },
        "deadSec": {
          "type": "integer",
          "minimum": 1,
          "default": 25
        },
        "cfgVersion": {
          "$ref": "#/$defs/CfgVersion"
        }
      }
    },
    "Bind": {
      "title": "BindFrame",
      "x-direction": "server_to_gateway",
      "description": "claim 직후(또는 bind 유실 재발급 시) 미바인딩 연결로 전달. GW 는 토큰 저장 → bound 응답 → 토큰으로 재접속.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "t",
        "gatewayToken",
        "siteId"
      ],
      "properties": {
        "t": {
          "const": "bind"
        },
        "gatewayToken": {
          "type": "string",
          "minLength": 32
        },
        "siteId": {
          "$ref": "#/$defs/SiteId"
        }
      }
    },
    "Cfg": {
      "title": "CfgFrame",
      "x-direction": "server_to_gateway",
      "description": "버전이 붙은 멱등 설정. GW 는 keys 목록에 있는 버전만 허용하고 시각으로 키 만료를 판단하지 않는다. 적용 후 cfg_ack.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "t",
        "cfgVersion",
        "siteId",
        "keys",
        "peers",
        "rules"
      ],
      "properties": {
        "t": {
          "const": "cfg"
        },
        "cfgVersion": {
          "type": "integer",
          "minimum": 1
        },
        "siteId": {
          "$ref": "#/$defs/SiteId"
        },
        "keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/SiteKey"
          }
        },
        "peers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Peer"
          }
        },
        "rules": {
          "$ref": "#/$defs/Rules"
        },
        "thread": {
          "$ref": "#/$defs/ThreadCfg"
        }
      }
    },
    "Ack": {
      "title": "AckFrame",
      "x-direction": "server_to_gateway",
      "description": "evt 누적 확인. 같은 bootId 의 seq ≤ upTo 는 링버퍼에서 지워도 된다.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "t",
        "bootId",
        "upTo"
      ],
      "properties": {
        "t": {
          "const": "ack"
        },
        "bootId": {
          "$ref": "#/$defs/BootId"
        },
        "upTo": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Req": {
      "title": "ReqFrame",
      "x-direction": "server_to_gateway",
      "description": "명령(제어·페어링·thread join·로그·OTA·공장초기화). GW 가 loopback 로컬 API 로 프록시하고 res 로 응답. 기존 req/res(relay.js) 와 호환.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "t",
        "id",
        "method",
        "path"
      ],
      "properties": {
        "t": {
          "const": "req"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "HEAD"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "headers": {
          "$ref": "#/$defs/StringMap"
        },
        "body": {
          "$ref": "#/$defs/Base64"
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600000,
          "description": "로컬 프록시 타임아웃. 없으면 GW 기본값"
        }
      }
    },
    "Ping": {
      "title": "PingFrame",
      "x-direction": "both",
      "description": "하트비트. 양방향 10초 주기, 25초 동안 프레임이 없으면 끊는다(monotonic 시계).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "t"
      ],
      "properties": {
        "t": {
          "const": "ping"
        }
      }
    },
    "Pong": {
      "title": "PongFrame",
      "x-direction": "both",
      "description": "ping 응답.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "t"
      ],
      "properties": {
        "t": {
          "const": "pong"
        }
      }
    },
    "Hello": {
      "title": "HelloFrame",
      "x-direction": "gateway_to_server",
      "description": "접속 인증. sig = Ed25519(UTF-8(challenge.nonce)) 의 base64url. pubKey = Ed25519 raw 공개키 32바이트 base64url. 서버는 사전 등록된 공개키만 받는다(미등록 4403).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "t",
        "proto",
        "gatewayId",
        "bootId",
        "agentVersion",
        "matterServerVersion",
        "startedAt",
        "clock",
        "cfgVersion",
        "keyVersion",
        "pubKey",
        "sig"
      ],
      "properties": {
        "t": {
