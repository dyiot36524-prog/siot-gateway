{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.siot.dev/protocol/public-v1-control.json",
  "title": "ControlResult",
  "description": "POST /v1/devices/{deviceId}/control 와 POST /app/v1/devices/{deviceId}/control 의 응답 본문(항상 HTTP 200). 계획 Step 1 N1: confirmed = 목표값 evt 확인(또는 req 송신 전 before 가 이미 목표값), timeout = deadline 3000ms 초과 또는 req 무응답, offline = 감지된 미연결, failed = 로컬 400/502·기기 offline(reason), not_found = 로컬 404.",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "device", "latencyMs"],
  "properties": {
    "status": { "$ref": "#/$defs/ControlStatus" },
    "device": {
      "description": "응답 시점의 캐시 기기 값(evt·snapshot 로만 갱신된 값). not_found 이면 null.",
      "oneOf": [{ "$ref": "#/$defs/Device" }, { "type": "null" }]
    },
    "latencyMs": { "type": "integer", "minimum": 0, "description": "API 수신부터 응답 결정까지(ms)" },
    "reason": { "type": "string", "description": "failed/timeout 일 때 기계 판독용 코드(DEVICE_UNREACHABLE, GATEWAY_TIMEOUT 등)" }
  },
  "$defs": {
    "ControlStatus": { "title": "ControlStatus", "type": "string", "enum": ["confirmed", "timeout", "offline", "failed", "not_found"] },
    "DeviceId": { "title": "DeviceId", "type": "string", "pattern": "^dev_[0-9A-HJKMNP-TV-Z]{26}$", "description": "'dev_' + ULID. 내부에서 (gatewayId, localId) 로 매핑" },
    "Device": {
      "title": "PublicDevice",
      "type": "object",
      "additionalProperties": false,
      "required": ["deviceId", "gatewayId", "siteId", "name", "room", "deviceType", "online", "data", "lastUpdated"],
      "properties": {
        "deviceId": { "$ref": "#/$defs/DeviceId" },
        "gatewayId": { "type": "string", "pattern": "^gw_[0-9a-f-]{36}$" },
        "siteId": { "type": "string", "pattern": "^site_[0-9A-HJKMNP-TV-Z]{26}$" },
        "name": { "type": "string" },
        "room": { "type": ["string", "null"] },
        "deviceType": { "$ref": "siot-device.json#/$defs/DeviceType" },
        "online": { "type": "boolean", "description": "기기 online 이면서 게이트웨이도 online" },
        "data": { "$ref": "siot-device.json#/$defs/DeviceData" },
        "lastUpdated": { "type": "string", "format": "date-time" },
        "vendor": { "type": ["string", "null"] },
        "model": { "type": ["string", "null"] }
      }
    }
  }
}
