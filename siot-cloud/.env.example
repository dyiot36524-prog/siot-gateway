# 시옷 클라우드 환경 변수. 로컬은 이 파일을 .env 로 복사(커밋 금지, 루트 .gitignore: siot-cloud/**/.env).
# 운영(Fly)은 아래 비밀 5개를 `fly secrets set` 으로 넣는다. 나머지는 fly.toml [env].

# ---- secrets (fly secrets set) ----
# Postgres 연결(1안 Fly Managed Postgres, 2안 Fly Postgres + wal-g). docs/ops/backup.md
DATABASE_URL=postgres://siot:siot@localhost:5432/siot
# 세션 서명용 32자 이상 임의 문자열 (openssl rand -base64 48)
SESSION_SECRET=
# 저장 비밀(세대 키·웹훅 서명 비밀·페어링 코드) AES-256-GCM 암호화 키 원천, 32자 이상. 바꾸면 기존 값 복호화 불가
DATA_ENC_KEY=
# 라벨 claimSecret = HMAC-SHA256(LABEL_MASTER_KEY, gatewayId) 앞 16 hex. 출고 라벨과 묶이므로 바꾸지 말 것
LABEL_MASTER_KEY=
# Slack 호환 incoming webhook(경보). 비우면 로그만
ALERT_WEBHOOK_URL=

# ---- 일반 ----
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
# 앱 origin: CSRF Origin 검사, https 면 세션 쿠키 Secure
APP_ORIGIN=http://localhost:5173
