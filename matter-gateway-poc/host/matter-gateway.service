# /etc/systemd/system/matter-gateway.service — 부팅 시 docker compose 자동 기동 (install.sh 가 설치)
[Unit]
Description=Siot Matter/Thread gateway (docker compose)
Requires=docker.service
After=docker.service network-online.target ipv6-forwarding-fix.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/matter-gateway
ExecStartPre=/usr/bin/docker compose pull --ignore-buildable --quiet
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
