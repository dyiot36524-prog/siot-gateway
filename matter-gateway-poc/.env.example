# install.sh 가 생성한다. 수동 수정 시 참고.
ZBT2_DEV=/dev/serial/by-id/usb-Nabu_Casa_Home_Assistant_Connect_ZBT-2_XXXX-if00
BACKBONE_IF=eth0
SIOT_GATEWAY_VERSION=0.2.0
# 외부 접속 릴레이(선택). 예: wss://<app>.fly.dev/gateway
SIOT_RELAY_URL=
# server | embedded
MATTER_BACKEND=server
LOG_LEVEL=info
# matterjs-server 이미지 (기본 stable). 예: ghcr.io/matter-js/matterjs-server:dev 또는 @sha256:... 로 고정
#MATTER_IMAGE=ghcr.io/matter-js/matterjs-server:stable
# BLE 연결이 간헐적으로 끊길 때 커미셔닝 재시도 횟수 (시도당 최대 3분)
PAIRING_MAX_ATTEMPTS=3
