# install.sh 가 생성한다. 수동 수정 시 참고.
ZBT2_DEV=/dev/serial/by-id/usb-Nabu_Casa_Home_Assistant_Connect_ZBT-2_XXXX-if00
BACKBONE_IF=eth0
SIOT_GATEWAY_VERSION=0.2.0
# production(출고 기본): LAN 3000 은 healthz·축소 /api/gateway·상태 페이지만, 전체 API 는 127.0.0.1:3001
# dev: 기존 단일 서버(:3000, 무인증 로컬 API·register·claim·?token=)
SIOT_MODE=production
# relay-v2 접속 주소. 비우면 wss://siot-cloud.fly.dev/gateway, off 면 비활성(로컬 전용)
SIOT_RELAY_URL=
# server | embedded | sim(가짜 백엔드, SIM_DOOR_TOGGLE_MS 로 도어 이벤트)
MATTER_BACKEND=server
#SIM_DOOR_TOGGLE_MS=0
LOG_LEVEL=info
# 이미지(OTA 대상). 허용 형식은 @sha256 digest 고정. 비우면 docker-compose.yml 의 기본 digest / 로컬 빌드
OTBR_IMAGE=openthread/border-router@sha256:70d2260eb5022f4c40be4f50195a1952d49041fc766fb3b2f213b06dcdc31a18
MATTER_IMAGE=ghcr.io/matter-js/matterjs-server@sha256:54232d0d3e7dff5a54759469d2753399270412b4c30c55b31750a4595e4cb236
# 출고 예: ghcr.io/dyiot36524-prog/siot-gateway-agent@sha256:<64hex>
AGENT_IMAGE=siot-matter-agent:local
# BLE 연결이 간헐적으로 끊길 때 커미셔닝 재시도 횟수 (시도당 최대 3분)
PAIRING_MAX_ATTEMPTS=3
